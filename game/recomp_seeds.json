// Spider-Man (SLUS_008.75, USA) recompiler seeds — the GAME half of the framework's function
// discovery (external/psxport/tools/recomp/emit.py --seeds).
//
// emit.py seeds discovery from the binary itself (the entry point plus its pointer/table scans) and
// grows the set by following direct `jal` targets. This file adds only what those scans CANNOT see:
// functions reached exclusively through a function pointer (`jalr`), or entered mid-body at a resume
// point. Every entry is a fact about THIS executable, which is why it lives in the game repo.
//
// It is EMPTY on purpose. The framework used to hardcode Tomba!2's seed list, and that list is
// actively wrong here: 27 of its 34 addresses land inside this game's text ([0x80010000,0x800C6800)),
// where each would declare a bogus function entry at an arbitrary offset and silently split a real
// function. Starting empty means every function in the substrate is one the binary itself vouches
// for.
//
// HOW TO ADD ONE — do not guess. A missing seed announces itself: the runtime fail-fasts with a
// [recomp-MISS] naming the address it could not dispatch to. Add that address here, with a note on
// HOW it is reached and which run surfaced it, then re-run ./run.sh. A seed with no rationale is
// unreviewable later, which is why the format allows `//` comments.
//
// A seed MUST lie inside the module text; emit.py fails with a readable diagnostic otherwise.
//
// Schema:
//   main                  [addr, ...]          resident-module seeds
//   main_reentry          [addr, ...]          mid-body re-entry points
//   overlay_bases         {STEM: addr}         overlay load addresses
//   overlay_seeds         {STEM: [addr, ...]}  per-overlay seeds
//
// RUNTIME-LOADED MODULES. SLUS_008.75 is not the whole game: further CODE lives in CD.WAD as
// <name>.bin + <name>.rel pairs, loaded and relocated at runtime by FUN_8001B990.
// tools/extract_modules.py performs that load offline (CD.HED index -> extract -> apply the .rel
// relocations) and writes a relocated image the recompiler consumes as an overlay, plus a
// <stem>.reloc.json sidecar naming the module's HI16 sites.
//
// THE BASE BELOW IS A LINK BASE, NOT A LOAD ADDRESS. The game allocates each module from its own
// heap, so where it runs depends on load order and differs per module and per playthrough, and
// several modules are resident at once (a level load puts L5A5LSC, LIZMAN and VENOM on the loader's
// list together). These modules are therefore emitted BASE-RELATIVE: the recompiler renders every
// address that moves with the module as `link address + delta`, and the port learns the real base by
// watching the guest's own allocator (game/core/module_loader.cpp). Changing this value changes
// nothing observable — it only has to be a fixed, valid guest address the whole build agrees on, and
// it must equal LINK_BASE in tools/extract_modules.py.
{
  "main": [],
  "main_reentry": [],
  // Every runtime-loaded module is recompiled at this LINK base (see the note above); it is not
  // where any of them runs.
  "overlay_base_patterns": [ [ ".*", "0x800C65EC" ] ],

  // Each module's ENTRY POINT is its base address, and nothing `jal`s to it: the loader calls it
  // through a pointer (`(*(code *)node[1])(node)` at the tail of FUN_8001B990), which is invisible
  // to jal-discovery. Without this seed a module's emitted set starts at its SECOND function and the
  // very first call into it fails with a recomp MISS on its base. Every module needs it, and they
  // are all expressed in the LINK base above.
  "overlay_seeds": {
    "SHELL": ["0x800C65EC"], "THUG": ["0x800C65EC"], "BLACKCAT": ["0x800C65EC"],
    "CARNAGE": ["0x800C65EC"], "CHOPPER": ["0x800C65EC"], "COP": ["0x800C65EC"],
    "DOCOCK": ["0x800C65EC"], "HOSTAGE": ["0x800C65EC"], "JONAH": ["0x800C65EC"],
    "L2A1LSC": ["0x800C65EC"], "L5A5LSC": ["0x800C65EC"], "L5A6LSC": ["0x800C65EC"],
    "L5A7LSC": ["0x800C65EC"], "L6A1LSC": ["0x800C65EC"], "L6A2LSC": ["0x800C65EC"],
    "L6A3LSC": ["0x800C65EC"], "LIZARD": ["0x800C65EC"], "LIZMAN": ["0x800C65EC"],
    "MJ": ["0x800C65EC"], "MYSTERIO": ["0x800C65EC"], "RHINO": ["0x800C65EC"],
    "SCORPION": ["0x800C65EC"], "SIMBY": ["0x800C65EC"], "SPCLONE": ["0x800C65EC"],
    "SUBMARIN": ["0x800C65EC"], "SUPEROCK": ["0x800C65EC"], "TORCH": ["0x800C65EC"],
    "TRAINING": ["0x800C65EC"], "TURRET": ["0x800C65EC"], "VENOM": ["0x800C65EC"]
  }
}
