// Spider-Man (SLUS_008.75, USA) recompiler seeds — the GAME half of the framework's function
// discovery (external/psxport/tools/recomp/emit.py --seeds).
//
// emit.py seeds discovery from the binary itself (the entry point plus its pointer/table scans) and
// grows the set by following direct `jal` targets. This file adds only what those scans CANNOT see:
// functions reached exclusively through a function pointer (`jalr`), or entered mid-body at a resume
// point. Every entry is a fact about THIS executable, which is why it lives in the game repo.
//
// It is EMPTY on purpose. The framework used to hardcode Tomba!2's seed list, and that list is
// actively wrong here: 27 of its 34 addresses land inside this game's text ([0x80010000,0x800C6800)),
// where each would declare a bogus function entry at an arbitrary offset and silently split a real
// function. Starting empty means every function in the substrate is one the binary itself vouches
// for.
//
// HOW TO ADD ONE — do not guess. A missing seed announces itself: the runtime fail-fasts with a
// [recomp-MISS] naming the address it could not dispatch to. Add that address here, with a note on
// HOW it is reached and which run surfaced it, then re-run ./run.sh. A seed with no rationale is
// unreviewable later, which is why the format allows `//` comments.
//
// A seed MUST lie inside the module text; emit.py fails with a readable diagnostic otherwise.
//
// Schema:
//   main                  [addr, ...]          resident-module seeds
//   main_reentry          [addr, ...]          mid-body re-entry points
//   overlay_bases         {STEM: addr}         overlay load addresses
//   overlay_seeds         {STEM: [addr, ...]}  per-overlay seeds
//
// RUNTIME-LOADED MODULES (corrected 2026-07-29 — this file previously said "this game has none").
// SLUS_008.75 is not the whole game: further CODE lives in CD.WAD as <name>.bin + <name>.rel pairs,
// loaded and relocated at runtime by FUN_8001B990. tools/extract_modules.py performs that load
// offline (CD.HED index -> extract -> apply the .rel relocations) and writes a relocated image the
// recompiler consumes as an ordinary overlay. The earlier "no overlays" reading came from the ISO
// tree having no overlay FILES, which is true and was quietly taken as a claim about code coverage.
//
// The base below is MEASURED, not read out of the binary — the game allocates the module from its
// own heap, so no static address exists to cite. It is the value observed at the module's entry
// call, identical across runs. It is not merely trusted: the framework's overlay router compares a
// 32-byte CONTENT SIGNATURE (baked into generated/overlay_table.c at emit time) against guest RAM at
// this base, and an address with no matching resident overlay fails fast in rec_dispatch_miss rather
// than routing to the wrong code. So a wrong base shows up as a loud MISS, not as silent corruption.
// Confirmed by relocating offline at this base and matching the running game's memory byte-for-byte
// over all 112912 bytes (CLAIM-08).
{
  // `main_reentry` is a MODIFIER, not a seed source: emit.py builds its seed set from `main` alone
  // (`seeds = {exe.entry} | gs["main"] | ...`) and uses `main_reentry` only to decide that the
  // fragment before a re-entry point must fall THROUGH into it rather than `return`. An address
  // listed only under `main_reentry` is therefore silently not a function — no error, just a
  // [recomp-MISS] later. Every re-entry point must appear in BOTH lists.
  "main": [
    "0x8002A424", "0x8002A708", "0x8002A774", "0x8002A77C",
    "0x8002A784", "0x8002A78C", "0x8002A794"
  ],

  // RE-16 — the seven resume points of the resumable bit-stream decoder at 0x8002A338.
  //
  // 0x8002A338 is hand-written assembly, not a compiler-emitted function. It uses `jal`/`jr $ra` as
  // an INTERNAL COROUTINE mechanism inside one stack frame, and it saves its whole register context —
  // including its continuation — to a global block at 0x80097D88, so it can be re-entered to carry on
  // where it left off ($a0 != 0 starts on a new input buffer, $a0 == 0 resumes):
  //
  //     8002A390  lw   $ra, 0x30($t6)      ; $t6 = 0x80097D88 — RESTORE the continuation
  //     8002A398  bnez $ra, 0x8002a43c     ;   ... one exists: re-enter the decode loop
  //     8002A7EC  or   $at, $zero, $ra     ; delay slot — capture the LIVE continuation
  //     8002A834  sw   $at, 0x30($t6)      ; STORE it back
  //
  // So `jr $ra` at 0x8002A460 is a computed jump to one of the addresses below, NOT a return. The
  // recompiler now emits it as a router dispatch (emit.py ra_computed_jumps), and the router can only
  // resolve a mid-body address that is seeded here.
  //
  // The list is every `jal` return address inside the guest body, enumerated over the WHOLE extent
  // 0x8002A338..0x8002A83C — not per call target. A previous attempt enumerated per target, got three
  // of these seven, and silently truncated the decoder at the other four.
  //
  // Reproduce:  python3 tools/redump_ram.py
  //             python3 external/psxport/tools/disasm.py <ram.bin> 0x8002A338 0x8002A840
  //             python3 tools/ra_classes.py          # asserts this set is exactly 7
  "main_reentry": [
    "0x8002A424",   // after  8002A41C  jal 0x8002a478
    "0x8002A708",   // after  8002A700  jal 0x8002a478
    "0x8002A774",   // after  8002A76C  jal 0x8002a478
    "0x8002A77C",   // after  8002A774  jal 0x8002a5f4
    "0x8002A784",   // after  8002A77C  jal 0x8002a5f4
    "0x8002A78C",   // after  8002A784  jal 0x8002a5f4
    "0x8002A794"    // after  8002A78C  jal 0x8002a5f4
  ],
  // ALL runtime-loaded modules share ONE slot, so they share one base. The port reserves that slot
  // as the heap's first block (game/core/module_loader.cpp) and intercepts the loader's body
  // allocation to place every module there; only one is ever resident, and the framework's overlay
  // router picks it by 32-byte content signature. The base is heapBase(0x800C65D4) + 0x18, MEASURED
  // with PSXPORT_DEBUG=alloc -- the allocator's `return puVar11 + 2` invites an 8-byte header
  // assumption and the real offset is 0x18. The runtime re-checks this against the reservation and
  // refuses to run quietly if they disagree.
  "overlay_base_patterns": [ [ ".*", "0x800C65EC" ] ],

  // Each module's ENTRY POINT is its base address, and nothing `jal`s to it: the loader calls it
  // through a pointer (`(*(code *)node[1])(node)` at the tail of FUN_8001B990), which is invisible
  // to jal-discovery. Without this seed a module's emitted set starts at its SECOND function and the
  // very first call into it fails with a recomp MISS on its base. Every module needs it, and they
  // all share the slot base.
  "overlay_seeds": {
    "SHELL": ["0x800C65EC"], "THUG": ["0x800C65EC"], "BLACKCAT": ["0x800C65EC"],
    "CARNAGE": ["0x800C65EC"], "CHOPPER": ["0x800C65EC"], "COP": ["0x800C65EC"],
    "DOCOCK": ["0x800C65EC"], "HOSTAGE": ["0x800C65EC"], "JONAH": ["0x800C65EC"],
    "L2A1LSC": ["0x800C65EC"], "L5A5LSC": ["0x800C65EC"], "L5A6LSC": ["0x800C65EC"],
    "L5A7LSC": ["0x800C65EC"], "L6A1LSC": ["0x800C65EC"], "L6A2LSC": ["0x800C65EC"],
    "L6A3LSC": ["0x800C65EC"], "LIZARD": ["0x800C65EC"], "LIZMAN": ["0x800C65EC"],
    "MJ": ["0x800C65EC"], "MYSTERIO": ["0x800C65EC"], "RHINO": ["0x800C65EC"],
    "SCORPION": ["0x800C65EC"], "SIMBY": ["0x800C65EC"], "SPCLONE": ["0x800C65EC"],
    "SUBMARIN": ["0x800C65EC"], "SUPEROCK": ["0x800C65EC"], "TORCH": ["0x800C65EC"],
    "TRAINING": ["0x800C65EC"], "TURRET": ["0x800C65EC"], "VENOM": ["0x800C65EC"]
  }
}
