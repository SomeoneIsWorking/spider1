# Build and runtime artifacts.
build/
scratch/

# Game inputs are provisioned locally and never committed: the disc image and anything extracted
# from it are the copyright holder's, not this repo's.
*.chd
*.bin
*.BIN
*.exe
SLUS_*
.env

# The framework. Not tracked: either a symlink to the workspace shared clone (local) or a
# private clone at psxport.pin (fresh machine). Managed by tools/psxport_sync.py.
/external/psxport
/external/re-harness
*.log

# Python bytecode — never committed. Compiled .pyc embed ABSOLUTE SOURCE PATHS, i.e. a machine-path
# leak that a TEXT-only audit cannot see, because they are binary.
.venv/
__pycache__/
*.pyc

# Editor / OS noise
compile_commands.json
.DS_Store

# Ghidra headless project (derived from your own disc image via tools/redump_ram.py)
scratch/ghidra/
scratch/decomp/
