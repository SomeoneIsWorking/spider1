# Build + generated artifacts (regenerated by run.sh / tools/ensure_recomp.py)
build/
scratch/
generated/

# The recompiled substrate's INPUTS are provisioned locally, never committed: the disc image and
# anything extracted from it are the copyright holder's, not this repo's.
*.chd
*.bin
*.BIN
*.exe
SLUS_*
.env

# The framework submodule's own working-tree noise
external/psxport/build/
external/psxport/scratch/
*.log

# Python bytecode — never committed. Compiled .pyc embed ABSOLUTE SOURCE PATHS, i.e. a machine-path
# leak that a TEXT-only audit cannot see, because they are binary.
__pycache__/
*.pyc

# Editor / OS noise
compile_commands.json
.DS_Store

# Ghidra headless project (derived from your own disc image via tools/redump_ram.py)
scratch/ghidra/
scratch/decomp/
